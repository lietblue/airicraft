#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
experiment_dir="$repo_root/experiments/optimus3_modal"
command="${1:-help}"
if [[ $# -gt 0 ]]; then
	shift
fi

usage() {
	cat <<'EOF'
usage: scripts/optimus3-modal <command> [args]

commands:
  self-test             run local non-billable contract tests
  dry-run               print the pinned manifest without contacting Modal
  preflight             build/import the runtime on one L40S
  cache                 download pinned weights on CPU into the Modal Volume
  engine-cache          download/verify the pinned MineStudio engine on CPU
  sim-preflight         boot the pinned engine under CPU Mesa/Xvfb
  smoke [Modal args]    run one embedding + synthetic-frame action on one L40S
  bench [Modal args]    benchmark the warmed recurrent action loop on one L40S
  episode [Modal args]  run one fixed-seed native MineStudio episode on one L40S
  episodes              run the locked ten-episode native competence gate
  failure-replay        replay the five locked failures and capture policy-view MP4s
EOF
}

require_modal() {
	if ! command -v modal >/dev/null 2>&1; then
		printf 'error: modal is not installed; see %s/README.md\n' "$experiment_dir" >&2
		exit 3
	fi
}

new_run_dir() {
	local kind="$1"
	local timestamp
	timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
	printf '%s/eval-output/optimus3-modal/%s-%s\n' "$repo_root" "$timestamp" "$kind"
}

run_remote() {
	local mode="$1"
	shift
	local run_dir
	run_dir="$(new_run_dir "$mode")"
	mkdir -p "$run_dir"
	python3 "$experiment_dir/contract.py" --output "$run_dir/run-manifest.json" --mode "$mode" "$@"
	printf 'run_dir: %s\n' "$run_dir"
	modal run "$experiment_dir/modal_app.py" --mode "$mode" --output "$run_dir/result.json" "$@"
}

verify_failure_replay_source() {
	local source_result="$repo_root/eval-output/optimus3-modal/20260715T133606Z-episodes/result.json"
	local expected_sha="ea6b38e87b95c7c471797e5e72b73b772c0ed10d79508a6de8e998386ee62302"
	if [[ ! -f "$source_result" ]]; then
		printf 'error: missing failure replay source: %s\n' "$source_result" >&2
		exit 4
	fi
	local actual_sha
	actual_sha="$(shasum -a 256 "$source_result" | awk '{print $1}')"
	if [[ "$actual_sha" != "$expected_sha" ]]; then
		printf 'error: failure replay source digest mismatch: expected %s, got %s\n' \
			"$expected_sha" "$actual_sha" >&2
		exit 4
	fi
}

case "$command" in
	self-test)
		cd "$repo_root"
		if [[ -f .envrc ]]; then
			# shellcheck disable=SC1091
			source .envrc
		fi
		python3 -m unittest discover -s experiments/optimus3_modal -p 'test_*.py'
		;;
	dry-run)
		python3 "$experiment_dir/contract.py" "$@"
		;;
	preflight | cache | engine-cache | sim-preflight | smoke | bench | episode | episodes)
		require_modal
		run_remote "$command" "$@"
		;;
	failure-replay)
		verify_failure_replay_source
		require_modal
		run_remote "$command" "$@"
		;;
	help | -h | --help)
		usage
		;;
	*)
		printf 'error: unknown command: %s\n' "$command" >&2
		usage >&2
		exit 2
		;;
esac
